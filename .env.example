# =============================================================================
# Environment Variables — Household Energy IDSS
# Copy this file to .env and adjust values for your setup.
# =============================================================================

# --- Backend (FastAPI) -------------------------------------------------------

# Port for the FastAPI server (default: 8000)
API_PORT=8000

# Ollama LLM server URL (default: http://localhost:11434)
# Install Ollama: https://ollama.com/download
# Then pull a model: ollama pull llama3:8b
OLLAMA_URL=http://localhost:11434

# Default LLM model to use for chat/narration (default: llama3:8b)
# Alternatives: deepseek-r1:1.5b (for low-RAM), mistral:7b, etc.
OLLAMA_MODEL=deepseek-r1:1.5b

# CORS origins allowed by the API (comma-separated)
# The Vite dev server on :5173 is allowed by default
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (React / Vite) ------------------------------------------------

# Base URL for API requests from the frontend
# In development, Vite proxies /api to this URL
VITE_API_URL=/api

# Ollama URL for frontend LLM features (should match OLLAMA_URL above)
VITE_OLLAMA_URL=http://localhost:11434

# Default LLM model for the frontend settings (should match OLLAMA_MODEL above)
VITE_OLLAMA_MODEL=deepseek-r1:1.5b
